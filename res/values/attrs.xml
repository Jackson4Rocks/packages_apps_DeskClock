<resources>

    <declare-styleable name="CircleView">
        <!-- Sets the center/radius of the circle relative to the view's bounds. -->
        <attr name="android:gravity" />
        <!-- The ARGB fill color of the circle. -->
        <attr name="fillColor" format="color" />
        <!-- The center x-coordinate of the circle. -->
        <attr name="centerX" format="dimension" />
        <!-- The center y-coordinate of the circle. -->
        <attr name="centerY" format="dimension" />
        <!-- The radius of the circle. -->
        <attr name="radius" format="dimension" />
    </declare-styleable>

    <attr name="onStateTransition">
        <enum name="actionDown" value="1" />
        <enum name="actionDownUp" value="3" />
        <enum name="actionUp" value="2" />
        <enum name="sharedValueSet" value="4" />
        <enum name="sharedValueUnset" value="5" />
    </attr>

    <attr name="viewTransitionMode">
        <enum name="allStates" value="1" />
        <enum name="currentState" value="0" />
        <enum name="noState" value="2" />
    </attr>

    <declare-styleable name="MotionButton">
        <attr format="dimension" name="round"/>
        <attr format="float" name="roundPercent"/>
    </declare-styleable>

    <attr name="appWidgetBackgroundTint" format="color" />
    <attr name="appWidgetLabelTint" format="color" />
    <attr name="appWidgetTextAppearancePrimary" format="reference" />
    <attr name="appWidgetTextAppearancePrimaryLabel" format="reference" />
    <attr name="appWidgetTextAppearanceSecondary" format="reference" />
    <attr name="appWidgetTextAppearanceSecondaryLabel" format="reference" />
    <attr name="appWidgetConfigBackground" format="color" />
    <attr name="appWidgetConfigTitle" format="color" />
    <attr name="appWidgetConfigSubtitle" format="color" />
    <attr name="appWidgetConfigBorder" format="color" />
    <attr name="appWidgetThemeTransparent" format="reference" />
    <attr name="appWidgetThemeSolid" format="reference" />

    <!--
        Tint painted over the blurred backdrop of the floating liquid glass bar. The value is a
        semi transparent color and is overridden by the time of day theme overlays.
    -->
    <attr name="deskClockGlassTint" format="color" />

    <!-- Solid fill for the About description boxes: pure black or white per mode. -->
    <attr name="aboutCardColor" format="color" />

    <!-- Big clock readouts: follows the theme normally, pure black in Light mode. -->
    <attr name="clockTextColor" format="color" />

    <!-- Timer pad fill: translucent glass in the dark theme, solid container in Light. -->
    <attr name="timerPadFill" format="color" />
    <!-- Side fab fill: translucent white glass in the dark theme, solid in Light. -->
    <attr name="fabSideFill" format="color" />
</resources>
