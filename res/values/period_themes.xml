<resources>

    <!--
        Time of day overlays. They are applied on top of Theme.DeskClock with force=true so only
        the listed attributes change. The overlays tint the dark surfaces with the light outside;
        every accent (primary, secondary, the glass) intentionally comes from the system's own
        color selection instead, so the bar, the buttons and the switches always stay on one
        theme together with the rest of the OS.
        The names intentionally contain no dots: a dotted name would silently chain a parent
        style, and these are meant to be bare overlays rather than theme subclasses.
    -->

    <style name="TimeOfDay_Day">
        <item name="colorSurface">@color/period_day_surface</item>
        <item name="colorSurfaceVariant">@color/period_day_surface_variant</item>
    </style>

    <style name="TimeOfDay_Afternoon">
        <item name="colorSurface">@color/period_afternoon_surface</item>
        <item name="colorSurfaceVariant">@color/period_afternoon_surface_variant</item>
    </style>

    <style name="TimeOfDay_Evening">
        <item name="colorSurface">@color/period_evening_surface</item>
        <item name="colorSurfaceVariant">@color/period_evening_surface_variant</item>
    </style>

    <style name="TimeOfDay_Night">
        <item name="colorSurface">@color/period_night_surface</item>
        <item name="colorSurfaceVariant">@color/period_night_surface_variant</item>
    </style>
</resources>
