<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    app:statusBarBackground="@null"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:contentInsetStart="0dp"
            tools:ignore="RtlSymmetry"
            android:gravity="center">

            <TextView
                android:id="@+id/title_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginStart="24dp"
                style="@style/TextAppearance.Title" />

        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <!-- MaxxOS: secondary round buttons (lap / reset / add) float just above the nav row -->
        <LinearLayout
            android:id="@+id/fab_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/maxxos_nav_margin_horizontal"
            android:layout_marginBottom="@dimen/maxxos_fab_clearance"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/left_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/maxxos_side_button_margin"
                android:contentDescription="@null"
                app:fabCustomSize="@dimen/maxxos_side_button_size"
                app:backgroundTint="?attr/colorSecondary"
                app:tint="?attr/colorOnSecondary" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/right_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/maxxos_side_button_margin"
                android:contentDescription="@null"
                app:fabCustomSize="@dimen/maxxos_side_button_size"
                app:backgroundTint="?attr/colorSecondary"
                app:tint="?attr/colorOnSecondary" />
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- MaxxOS: bottom row = floating pill navigation + round main button beside it -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/maxxos_nav_margin_horizontal"
        android:paddingEnd="@dimen/maxxos_nav_margin_horizontal"
        android:paddingTop="@dimen/maxxos_nav_margin_vertical"
        android:paddingBottom="@dimen/maxxos_nav_margin_vertical">

        <com.android.deskclock.widget.MaxxOSLiquidNavigationView
            android:id="@+id/bottom_view"
            android:layout_width="0dp"
            android:layout_height="@dimen/maxxos_nav_height"
            android:layout_weight="1"
            android:background="@drawable/maxxos_nav_pill"
            android:elevation="@dimen/maxxos_nav_elevation"
            app:menu="@menu/bottom_navigation_menu"
            app:itemIconTint="@color/tab_tint_color"
            app:itemTextColor="@color/tab_tint_color"
            app:itemTextAppearanceActive="@style/navText"
            app:itemTextAppearanceInactive="@style/navText"
            app:itemActiveIndicatorStyle="@style/Widget.MaxxOS.BottomNav.ActiveIndicator"
            app:labelVisibilityMode="selected" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/maxxos_fab_gap"
            android:contentDescription="@null"
            app:fabCustomSize="@dimen/maxxos_nav_height"
            app:backgroundTint="?attr/colorPrimary"
            app:tint="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
